 #include "../../inc/MarlinConfig.h"
 #include "MarlinSerial.h"
 #include <libmaple/usart.h>
+#include <libmaple/dma.h>
 
 volatile uint32_t printerUartOverruns, printerUartFrames, printerUartParity, printerUartFull;
+uint32_t printerUartDmaStarts;
+
+static PrinterRxDmaCursor printerRxDma;
+static volatile uint32_t printerRxDmaProduced;
+static volatile bool printerRxDmaError;
+static uint32_t printerRxDmaCr1, printerRxDmaCr3;
+
+static void printer_rx_dma_irq() {
+  const uint8_t flags = dma_get_isr_bits(DMA1, DMA_CH3);
+  if (!(flags & (DMA_ISR_TCIF | DMA_ISR_TEIF))) return;
+  dma_clear_isr_bits(DMA1, DMA_CH3);
+  if (flags & DMA_ISR_TCIF) printerRxDmaProduced += PrinterRxDmaCursor::capacity;
+  if (flags & DMA_ISR_TEIF) {
+    printerRxDmaError = true;
+    USART3->regs->CR3 &= ~USART_CR3_DMAR;
+    dma_disable(DMA1, DMA_CH3);
+  }
+}
+
+static uint32_t printer_rx_dma_position(uint16_t &tail) {
+  uint16_t remaining;
+  do {
+    printer_rx_dma_irq();
+    remaining = dma_get_count(DMA1, DMA_CH3);
+  } while ((dma_get_isr_bits(DMA1, DMA_CH3) & DMA_ISR_TCIF)
+           || (!remaining && dma_is_enabled(DMA1, DMA_CH3)));
+  tail = remaining ? PrinterRxDmaCursor::capacity - remaining : 0;
+  return printerRxDmaProduced + tail;
+}
+
+bool MarlinSerial::rxDmaActive() const {
+  return this == static_cast<const MarlinSerial *>(&MSerial3) && printerRxDma.active;
+}
+
+bool MarlinSerial::beginRxDma() {
+  #if MB(MKS_ROBIN_NANO) && ENABLED(BINARY_FILE_TRANSFER) && !HAS_SPI_TFT && SPI_DEVICE != 1
+    if (c_dev() != USART3) return false;
+    if (printerRxDma.active) return true;
+    dma_init(DMA1);
+    if (dma_is_enabled(DMA1, DMA_CH3) || DMA1->handlers[DMA_CH3 - 1].handler) return false;
+    usart_reg_map * const regs = c_dev()->regs;
+    ring_buffer * const rb = c_dev()->rb;
+    nvic_irq_disable(c_dev()->irq_num);
+    printerRxDmaCr1 = regs->CR1 & (USART_CR1_RXNEIE | USART_CR1_PEIE);
+    printerRxDmaCr3 = regs->CR3 & USART_CR3_EIE;
+    regs->CR1 &= ~(USART_CR1_RXNEIE | USART_CR1_PEIE);
+    regs->CR3 &= ~USART_CR3_EIE;
+    printerRxDma.begin(rb->buf, rb->head, rb->tail);
+    printerRxDmaProduced = 0;
+    printerRxDmaError = false;
+    dma_setup_transfer(DMA1, DMA_CH3, &regs->DR, DMA_SIZE_8BITS, rb->buf, DMA_SIZE_8BITS,
+                       DMA_MINC_MODE | DMA_CIRC_MODE | DMA_TRNS_CMPLT | DMA_TRNS_ERR);
+    dma_set_num_transfers(DMA1, DMA_CH3, PrinterRxDmaCursor::capacity);
+    dma_set_priority(DMA1, DMA_CH3, DMA_PRIORITY_VERY_HIGH);
+    dma_clear_isr_bits(DMA1, DMA_CH3);
+    dma_attach_interrupt(DMA1, DMA_CH3, printer_rx_dma_irq);
+    dma_enable(DMA1, DMA_CH3);
+    regs->CR3 |= USART_CR3_DMAR;
+    nvic_irq_enable(c_dev()->irq_num);
+    printerUartDmaStarts++;
+    return true;
+  #else
+    return false;
+  #endif
+}
+
+void MarlinSerial::endRxDma() {
+  if (!rxDmaActive()) return;
+  const bool irq_enabled = !__get_primask();
+  nvic_globalirq_disable();
+  c_dev()->regs->CR3 &= ~USART_CR3_DMAR;
+  dma_disable(DMA1, DMA_CH3);
+  uint16_t tail;
+  const uint32_t produced = printer_rx_dma_position(tail);
+  if (printerRxDma.end(produced, tail)) ++printerUartFull;
+  c_dev()->rb->head = printerRxDma.head;
+  c_dev()->rb->tail = tail;
+  dma_detach_interrupt(DMA1, DMA_CH3);
+  dma_clear_isr_bits(DMA1, DMA_CH3);
+  c_dev()->regs->CR1 |= printerRxDmaCr1;
+  c_dev()->regs->CR3 |= printerRxDmaCr3;
+  if (irq_enabled) nvic_globalirq_enable();
+}
+
+int MarlinSerial::available() {
+  if (!rxDmaActive()) return HardwareSerial::available();
+  const bool irq_enabled = !__get_primask();
+  nvic_globalirq_disable();
+  uint16_t tail;
+  const uint32_t produced = printer_rx_dma_position(tail);
+  const uint32_t pending = printerRxDma.available(produced);
+  if (irq_enabled) nvic_globalirq_enable();
+  if (printerRxDmaError || pending >= PrinterRxDmaCursor::capacity) {
+    endRxDma();
+    return HardwareSerial::available();
+  }
+  return pending;
+}
+
+int MarlinSerial::peek() {
+  if (!rxDmaActive()) return HardwareSerial::peek();
+  return available() ? c_dev()->rb->buf[printerRxDma.head] : -1;
+}
+
+int MarlinSerial::read() {
+  if (!rxDmaActive()) return HardwareSerial::read();
+  const int pending = available();
+  if (!rxDmaActive()) return HardwareSerial::read();
+  return printerRxDma.read(c_dev()->rb->buf, printerRxDma.consumed + pending);
+}
 
