+struct PrinterRxDmaCursor {
+  static constexpr uint16_t capacity = 1280;
+  volatile bool active = false;
+  uint16_t head = 0;
+  uint32_t consumed = 0;
+
+  void begin(volatile uint8_t *buffer, const uint16_t old_head, const uint16_t old_tail) {
+    const uint16_t pending = (old_tail + capacity - old_head) % capacity;
+    auto reverse = [&](uint16_t first, uint16_t last) {
+      while (first < last) {
+        const uint8_t byte = buffer[first];
+        buffer[first++] = buffer[--last];
+        buffer[last] = byte;
+      }
+    };
+    reverse(0, old_tail);
+    reverse(old_tail, capacity);
+    reverse(0, capacity);
+    head = pending ? capacity - pending : 0;
+    consumed = uint32_t(0) - pending;
+    active = true;
+  }
+
+  uint32_t available(const uint32_t produced) const { return produced - consumed; }
+
+  int peek(const volatile uint8_t *buffer, const uint32_t produced) const {
+    return available(produced) ? buffer[head] : -1;
+  }
+
+  int read(const volatile uint8_t *buffer, const uint32_t produced) {
+    const int byte = peek(buffer, produced);
+    if (byte >= 0) {
+      if (++head == capacity) head = 0;
+      ++consumed;
+    }
+    return byte;
+  }
+
+  bool end(const uint32_t produced, const uint16_t tail) {
+    const bool overflow = available(produced) >= capacity;
+    if (overflow) {
+      head = tail + 1 == capacity ? 0 : tail + 1;
+      consumed = produced - (capacity - 1);
+    }
+    active = false;
+    return overflow;
+  }
+};
 
