--- /dev/null
+++ b/Marlin/src/libs/crc32.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+inline uint32_t crc32_update(uint32_t crc, const uint8_t *data, size_t size) {
+  for (size_t i = 0; i < size; ++i) {
+    crc ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit)
+      crc = (crc >> 1) ^ ((uint32_t(0) - (crc & 1)) & 0xEDB88320UL);
+  }
+  return crc;
+}
