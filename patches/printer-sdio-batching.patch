+bool SDIO_WriteBlocks(uint32_t blockAddress, const uint8_t *data, uint16_t count) {
+  if (!data || !count || count > 0xFFFFU / 128U) return false;
+  if (count == 1) return SDIO_WriteBlock(blockAddress, data);
+  if ((uintptr_t(data) & 3U) || blockAddress >= SdCard.LogBlockNbr || count > SdCard.LogBlockNbr - blockAddress) return false;
+  const uint32_t transferStarted = micros();
+  if (SDIO_GetCardState() != SDIO_CARD_TRANSFER) return false;
+  if (SdCard.CardType != CARD_SDHC_SDXC) blockAddress *= 512U;
+
+  dma_disable(SDIO_DMA_DEV, SDIO_DMA_CHANNEL);
+  SDIO->DCTRL &= ~(SDIO_DCTRL_DMAEN | SDIO_DCTRL_DTEN);
+  dma_clear_isr_bits(SDIO_DMA_DEV, SDIO_DMA_CHANNEL);
+  SDIO_CLEAR_FLAG(SDIO_ICR_CMD_FLAGS | SDIO_ICR_DATA_FLAGS);
+
+  bool transferred = false;
+  if (SDIO_CmdWriteMultipleBlock(blockAddress)) {
+    dma_setup_transfer(SDIO_DMA_DEV, SDIO_DMA_CHANNEL, &SDIO->FIFO, DMA_SIZE_32BITS, (volatile void *)data, DMA_SIZE_32BITS, DMA_MINC_MODE | DMA_FROM_MEM);
+    dma_set_num_transfers(SDIO_DMA_DEV, SDIO_DMA_CHANNEL, 128U * count);
+    dma_enable(SDIO_DMA_DEV, SDIO_DMA_CHANNEL);
+    const uint32_t dataTimeout = SDIO_DATA_TIMEOUT * uint32_t(count);
+    sdio_setup_transfer(dataTimeout * (F_CPU / 1000U), 512U * count, SDIO_BLOCKSIZE_512 | SDIO_DCTRL_DMAEN | SDIO_DCTRL_DTEN);
+    const uint32_t started = millis();
+    do {
+      if (SDIO_GET_FLAG(SDIO_STA_TRX_ERROR_FLAGS) || (DMA2_BASE->ISR & DMA_ISR_TEIF4)) break;
+      if (SDIO_GET_FLAG(SDIO_STA_DATAEND) && (DMA2_BASE->ISR & DMA_ISR_TCIF4)) {
+        transferred = true;
+        break;
+      }
+    } while (uint32_t(millis() - started) < dataTimeout);
+  }
+
+  dma_disable(SDIO_DMA_DEV, SDIO_DMA_CHANNEL);
+  SDIO->DCTRL &= ~(SDIO_DCTRL_DMAEN | SDIO_DCTRL_DTEN);
+  if (SDIO_GET_FLAG(SDIO_STA_TRX_ERROR_FLAGS) || (DMA2_BASE->ISR & DMA_ISR_TEIF4)) transferred = false;
+  if (transferred) {
+    sdioWriteCalls += count;
+    sdioTransferUs += uint32_t(micros() - transferStarted);
+  }
+  const uint32_t busyStarted = micros();
+  const bool stopped = SDIO_CmdStopTransfer();
+  dma_clear_isr_bits(SDIO_DMA_DEV, SDIO_DMA_CHANNEL);
+  SDIO_CLEAR_FLAG(SDIO_ICR_CMD_FLAGS | SDIO_ICR_DATA_FLAGS);
+  const uint32_t started = millis();
+  do {
+    const uint32_t state = SDIO_GetCardState();
+    if (state == SDIO_CARD_ERROR) break;
+    if (state == SDIO_CARD_TRANSFER && (SDIO_GetResponse(SDIO_RESP1) & (1U << 8))) {
+      if (transferred) {
+        const uint32_t spent = micros() - busyStarted;
+        sdioBusyUs += spent;
+        if (spent > sdioMaxBusyUs) sdioMaxBusyUs = spent;
+      }
+      return transferred && stopped;
+    }
+  } while (uint32_t(millis() - started) < SDIO_WRITE_TIMEOUT);
+  return false;
+}
+
